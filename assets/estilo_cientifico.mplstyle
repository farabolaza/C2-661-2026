### Configuraciones base ###
# figure.figsize: 4.5, 3
# figure.dpi: 300
# figure.autolayout: True
# figure.facecolor: white

### Tipografía ###
font.family: serif
font.serif: STIXGeneral, Times New Roman, Times, serif
font.size: 12
mathtext.fontset: stix
text.usetex: False

### Ejes ###
axes.labelsize: 14
axes.titlesize: 16
axes.titleweight: bold
axes.linewidth: 1.2
axes.grid: True
axes.axisbelow: True  # Grilla detrás de los datos
axes.prop_cycle: cycler('color', ['1f77b4', 'ff7f0e', '2ca02c', 'd62728', '9467bd', '8c564b', 'e377c2'])

### Marcadores y Líneas ###
lines.linewidth: 2.0
lines.markersize: 8
lines.markeredgewidth: 1.0

### Marcas de Ejes ###
xtick.direction: in
ytick.direction: in
xtick.labelsize: 12
ytick.labelsize: 12
xtick.major.size: 6
xtick.major.width: 1.0
ytick.major.size: 6
ytick.major.width: 1.0

### Leyenda ###
legend.fontsize: 12
legend.frameon: True
legend.framealpha: 0.8
legend.edgecolor: black

### Grilla ###
grid.linestyle: --
grid.linewidth: 0.8
grid.alpha: 0.6

### Ahorro de Tinta (ocultar bordes innecesarios) ###
axes.spines.right: False
axes.spines.top: False